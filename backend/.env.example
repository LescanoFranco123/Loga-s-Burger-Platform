# Copiá este archivo como .env y completá los valores para producción.
# En local no hace falta crear este archivo: si no existe, se usan los
# valores por defecto (puerto 5000, CORS abierto, secreto de ejemplo).

# Puerto en el que corre el servidor. La mayoría de los hostings (Render,
# Railway, Fly) lo definen ellos automáticamente, no hace falta tocarlo.
PORT=5000

# Origen permitido para hacer pedidos a la API. Poné acá la URL de tu
# frontend en producción, por ejemplo: https://tuapp.vercel.app
CORS_ORIGIN=*

# Clave secreta para firmar los tokens de sesión. En producción, cambiala
# por una clave larga y aleatoria (no la compartas ni la subas a GitHub).
JWT_SECRET=cambiar-esta-clave-en-produccion
